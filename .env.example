# ============================================================
#  Sentra AI Gateway — Environment Configuration Template
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ============================================================

# ── General ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend-only secrets (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Database (Supabase Postgres) ─────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string
# Format: postgresql+asyncpg://postgres.[project-id]:[password]@[host]:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:changeme@aws-0-region.pooler.supabase.com:6543/postgres

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:${REDIS_PORT}/0

# ── Backend (FastAPI) ────────────────────────────────────────
BACKEND_PORT=8000
PYTHONPATH=/app

# ── Frontend (Next.js) ───────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}/api/v1
WATCHPACK_POLLING=true
HOSTNAME=0.0.0.0

# ── LLM Provider API Keys ───────────────────────────────────
#   OpenAI:    https://platform.openai.com/api-keys
#   Gemini:    https://aistudio.google.com/app/apikey
#   Anthropic: https://console.anthropic.com/settings/keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Security Thresholds ─────────────────────────────────────
PROMPT_INJECTION_BLOCK_THRESHOLD=0.85
PROMPT_INJECTION_SANITIZE_THRESHOLD=0.60
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# ── CORS ─────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
